{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/media-downloader-helpers": "./src/lib/media-downloader-helpers.ts",
    "./lib/influencer-pipeline": "./src/lib/influencer-pipeline.ts",
