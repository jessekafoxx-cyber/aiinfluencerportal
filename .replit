modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PUBLIC_APP_URL = "https://portal.aiinfluencerpublishing.com"
VIKTOR_SLACK_USER_ID = "U0BNUR2161J"
ADMIN_EMAILS = "greg@cookemedia.io,jesseka@maketruechange.org"

[objectStorage]
defaultBucketID = "replit-objstore-36a07ead-12e4-441e-8c45-24d3922975d6"
